# Public Firebase configuration: NOT the service account private key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=
# Empty API URL works for local web development via Vite proxy.
# Android needs the deployed HTTPS Worker URL.
VITE_DISTRIBUTION=play
